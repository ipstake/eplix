{
 "title": "Eplix",
 "uid": "eplix-vc",
 "tags": [
  "eplix",
  "validator"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "description": "Eplix validator client: duties, keys, signing, beacon nodes, chain view, process, TLS files, signer states, builder flow. Alerts and runbook: contrib/prometheus/eplix-alerts.yml, docs/runbook.md.",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Data source"
   },
   {
    "name": "job",
    "type": "custom",
    "query": "eplix",
    "current": {
     "text": "eplix",
     "value": "eplix"
    },
    "label": "Job"
   },
   {
    "name": "instance",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(eplix_build_info{job=\"$job\"}, instance)",
     "refId": "instance"
    },
    "definition": "label_values(eplix_build_info{job=\"$job\"}, instance)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "label": "Instance"
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "links": [],
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "id": 2,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Build",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "eplix_build_info{job=\"$job\",instance=~\"$instance\"}",
     "legendFormat": "{{instance}} {{version}}",
     "refId": "A"
    }
   ],
   "description": "",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "stat",
   "title": "Active keys",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (instance) (eplix_keys{job=\"$job\",instance=~\"$instance\",state=\"active\"})",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "description": "",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
